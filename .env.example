# Copy this file to .env and adjust as needed.
# .env is gitignored - it is where your REAL local settings live.

# Path to your real service key (never commit the file it points to)
SERVICE_KEY_PATH=config/service_key.json

# One of DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# HTTP request timeout in seconds, used for auth + all API calls
TIMEOUT=10

# Optional - only needed for the Security Auditor (Audit Log API).
# This is a SEPARATE service instance/key from SERVICE_KEY_PATH above.
# Leave unset if you haven't provisioned an auditlog-management instance yet.
AUDIT_LOG_SERVICE_KEY_PATH=config/audit_log_service_key.json

# Optional - only needed for the Access Auditor (Authorization Management API).
# This is a SEPARATE XSUAA instance on the 'apiaccess' plan, not your main
# login XSUAA instance. Leave unset if you haven't provisioned one yet --
# the Access Auditor will fall back to the main token and likely show
# "Access denied" instead.
APIACCESS_SERVICE_KEY_PATH=config/xsuaa_api_access.json
